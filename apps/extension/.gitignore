# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
# NOTE: dist/ is intentionally NOT ignored — Chrome loads the extension directly
# from dist/. It must be committed so the extension works after cloning.

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# .env.example is intentionally tracked (safe template, no real secrets)

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
__MACOSX/
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── TypeScript cache ──────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Packaged extension zip ────────────────────────────────────────────────────
*.zip
