# ─── Privo Page Agent — Backend ──────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key (never expose this to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret between the extension and this backend.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The extension must have the same value in VITE_EXTENSION_SECRET.
EXTENSION_SECRET=

# Signing secret for HMAC-sealing capture records.
# Auto-generated on first run if left blank; after first run, copy the generated
# value here so records survive a server restart.
SIGNING_SECRET=

# Port the local server listens on (default 8787, must match extension config)
PORT=8787
